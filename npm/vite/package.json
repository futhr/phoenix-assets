{
  "name": "@phoenix-assets/vite",
  "version": "0.1.0",
  "description": "Vite plugin for phoenix_assets: $phoenix/* virtual modules, the generated-contracts HMR bridge, a PO loader, and the asset-graph emitter.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/futhr/phoenix_assets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futhr/phoenix_assets.git",
    "directory": "npm/vite"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check:publish": "publint && attw --pack . --profile esm-only -q"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@vitest/coverage-v8": "^4.1.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
