{
  "name": "@phoenix-assets/doc-shell",
  "version": "0.1.0",
  "description": "Renderer-neutral Svelte documentation shell for DocShell artifacts.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/futhr/phoenix-assets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futhr/phoenix-assets.git",
    "directory": "npm/doc-shell"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --coverage",
    "check:offline": "node scripts/check-offline.mjs",
    "check:stories": "node scripts/check-stories.mjs",
    "check:publish": "publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error no-resolution -q"
  },
  "peerDependencies": {
    "svelte": "^5.7.0"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "fuse.js": "^7.5.0",
    "mermaid": "^11.16.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
