{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "npm/vite": { "project": "src/**/*.ts" },
    "npm/svelte": { "project": "src/**/*.{ts,svelte}" },
    "npm/doc-shell": {
      "entry": ["src/**/*.stories.svelte", "test/**/*.ts"],
      "project": ["src/**/*.{ts,svelte}", "test/**/*.ts", "*.{ts,js}"],
      "ignoreDependencies": ["@phoenix-assets/svelte", "@phoenix-assets/vite"]
    },
    "npm/lint": { "project": "*.{ts,svelte,css}" }
  }
}
