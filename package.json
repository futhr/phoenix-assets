{
  "name": "@phoenix-assets/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Monorepo for the phoenix_assets npm packages.",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --unsafe .",
    "knip": "knip",
    "check:exports": "pnpm -r build && pnpm -r run check:publish",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.4",
    "knip": "^6.26.0",
    "publint": "^0.3.21",
    "typescript": "catalog:"
  }
}
